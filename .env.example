# Base URL of car-sale-backend (NestJS), including the /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional: URL the Next.js server uses for server-side fetches (e.g. a Docker
# service name). Defaults to NEXT_PUBLIC_API_URL.
# API_URL=http://api:4000/api/v1

# Public origin of this site (canonical URLs, sitemap.xml, Open Graph). Set to the live domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
